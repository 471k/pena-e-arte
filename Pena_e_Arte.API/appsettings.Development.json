{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=pena_e_arte_dev;User=root;Password=root;AllowPublicKeyRetrieval=true;"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "pena-e-arte-dev",
    "Audience": "pena-e-arte-dev",
    "SecretKey": "dev-secret-key-min-32-chars-long!!",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },
  "Stripe": {
    "SecretKey": "STRIPE_SECRET_KEY_REDACTED_FROM_HISTORY",
    "PublishableKey": "STRIPE_PUBLISHABLE_KEY_REDACTED_FROM_HISTORY",
    "WebhookSecretBilling": "",
    "WebhookSecretConnect": ""
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "FromNumber": ""
  },
  "MailKit": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@pena-e-arte.dev",
    "FromName": "Pena e Artë Dev"
  },
  "CloudflareR2": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "BucketName": "pena-e-arte-dev",
    "PublicUrl": "http://localhost:9000"
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "DashboardUsername": "admin",
    "DashboardPassword": "admin"
  },
  "OpenTelemetry": {
