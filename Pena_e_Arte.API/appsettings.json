{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SecretKey": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecretBilling": "",
    "WebhookSecretConnect": ""
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "FromNumber": ""
  },
  "Resend": {
    "ApiKey": "",
    "FromAddress": "",
    "FromName": ""
  },
  "CloudflareR2": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "BucketName": "",
    "PublicUrl": ""
  },
  "Instagram": {
    "AppId": "",
    "AppSecret": "",
    "RedirectUri": "",
    "TokenEncryptionKey": ""
  },
  "Google": {
    "ClientId": ""
  },
  "Apple": {
    "ClientId": ""
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "DashboardUsername": "",
    "DashboardPassword": ""
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "App": {
    "BaseUrl": "",
    "LegalEntityName": "",
    "LegalEntityNipt": ""
  },
  "Seeding": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
