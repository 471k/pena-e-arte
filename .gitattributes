# Normalize line endings on check-in; let .editorconfig control working-copy endings
* text=auto

# Force LF for files that must never have CRLF (JSON parsed by Node/Vite tooling)
*.json text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.sh   text eol=lf

# Git hooks are shell scripts with no extension — a CRLF shebang breaks them on Linux/macOS
.githooks/** text eol=lf

# Windows-native files keep CRLF
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Binary — never mangle
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
