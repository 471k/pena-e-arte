# Copy to .env and fill in for `docker compose up api frontend` (container-parity
# testing). Never commit the populated .env — it's gitignored.

ASPNETCORE_ENVIRONMENT=Development

DB_CONNECTION_STRING=Server=mysql;Port=3306;Database=pena_e_arte_dev;User=root;Password=root;AllowPublicKeyRetrieval=true;
REDIS_CONNECTION_STRING=redis:6379,connectTimeout=500,syncTimeout=500,abortConnect=false

# Only needed if something else on the host already holds 3306 (e.g. a native
# MySQL install/service). This only remaps the host-side publish — the api
# container still reaches the mysql container internally at mysql:3306 regardless.
MYSQL_HOST_PORT=3306

JWT_ISSUER=tattoos-dev
JWT_AUDIENCE=tattoos-dev
JWT_SECRET_KEY=dev-secret-key-min-32-chars-long!!

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET_BILLING=
STRIPE_WEBHOOK_SECRET_CONNECT=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional: destination bucket for R2ExportJob's daily backup copy. Left blank locally —
# the job no-ops gracefully when unset (see docs/infra/backup-dr-runbook.md). Deliberately a
# SEPARATE token from R2_ACCESS_KEY_ID/SECRET above, scoped only to the backup bucket.
R2_BACKUP_BUCKET_NAME=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_FROM_NAME=TattooOS

# Twilio (SMS notifications) — wired into the api container so a composed deployment
# doesn't silently run with empty SMS credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Instagram (artist portfolio sync)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Social verification (studio Instagram + TikTok/Facebook/X/YouTube Connect and
# manual bio-code checks). Empty by default — a platform stays config-gated
# (ISocialOAuthProvider.IsConfigured / ISocialBioChecker.IsSupported == false) until
# real credentials exist. SOCIAL_STATE_SIGNING_KEY is a base64 32-byte HMAC key,
# separate from INSTAGRAM_TOKEN_ENCRYPTION_KEY.
SOCIAL_STATE_SIGNING_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_BEARER_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_API_KEY=

# Secrets backend (Vault). Local dev-mode Vault: VAULT_ADDR=http://vault:8200 (from the
# api container) or http://127.0.0.1:8200 (from the host), VAULT_TOKEN=<dev root token>.
# The dev-mode root token is set by VAULT_DEV_ROOT_TOKEN (see docker-compose vault service).
# Dev only — never a real production Vault posture. See docs/infra/ADR-0002-secrets-management.md.
VAULT_DEV_ROOT_TOKEN=dev-only-not-for-prod
VAULT_ADDR=
VAULT_TOKEN=

VITE_CONTACT_EMAIL=support@tattooos.co
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_PUBLIC_URL=http://localhost:8081

# /hangfire dashboard basic auth — generate real values, do not use admin/admin
# even for local testing. e.g. `openssl rand -base64 24` for the password.
HANGFIRE_DASHBOARD_USERNAME=
HANGFIRE_DASHBOARD_PASSWORD=

# CIDR of the trusted reverse-proxy/ingress network (e.g. the K3s ingress subnet),
# so X-Forwarded-For is only honored from a known proxy hop and can't be spoofed by a
# direct client to bypass IP-keyed rate limiting. Left empty locally (trusts all
# proxies, logs a startup warning) — set this to the real ingress CIDR in production.
FORWARDED_HEADERS_TRUSTED_PROXY_CIDR=

# Grafana admin login — generate a real value, do not use admin/admin even locally.
# e.g. `openssl rand -base64 24`
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Only needed if the API runs containerized (docker compose up --build api). When running
# via `dotnet run` on the host, appsettings.Development.json's localhost:4317 already works
# since Tempo's OTLP port is published to the host.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Live traffic analytics (GeoIP) — path to the local GeoLite2-City.mmdb (see
# docs/claude/overnight-prompt-live-traffic-analytics-2026-08-03.md §3.1/§6.1).
# Refreshed monthly by geoipupdate using GeoIP.conf (gitignored, holds the
# MaxMind AccountID/LicenseKey — never put those here). Pepper: generate with
# `openssl rand -base64 32`, never reuse the example/dev value in production.
GEOIP_DATABASE_PATH=./data/geoip/GeoLite2-City.mmdb
GEOIP_IP_HASH_PEPPER=
